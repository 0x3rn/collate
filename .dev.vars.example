# Template of local Workers environment variables (tracked in Git with blank values).
# Local development uses .dev.vars (automatically created and git-ignored).
# Production secrets are set via: wrangler secret put <NAME>

# Local runtime override
APP_ENV=
APP_URL=
EXPORT_SIGNING_SECRET=
# Comma-separated operator emails allowed to access /admin
ADMIN_EMAILS=

# Payments (Paystack NGN & Stripe International)
# Paystack secret key (sk_test_... / sk_live_...)
PAYSTACK_SECRET_KEY=
# Stripe secret key (sk_test_... / sk_live_...)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 (optional; loaded only after visitor/user accepts analytics cookies)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Email Delivery
EMAIL_PROVIDER=
EMAIL_FROM=
# Email is sent through the Cloudflare Email Sending binding (EMAIL in wrangler.jsonc).
# Use "console" locally to print emails instead of sending them.

# Web Search & Scholarly Source APIs
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
SCHOLARLY_CONTACT_EMAIL=

# Cloudflare AI Gateway & Anthropic
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_ID=
CLOUDFLARE_AI_GATEWAY_TOKEN=
ANTHROPIC_API_KEY=
ALLOW_DIRECT_ANTHROPIC=
LLM_MODEL_DRAFT=
LLM_MODEL_VERIFY=
LLM_MODEL_EXTRACT=
LLM_MODEL_CLASSIFY=

# Internal Smoke Routes & Observability
INTERNAL_SMOKE_TOKEN=
SENTRY_DSN=

# Owner alerts on Telegram (payments, new sign-ups, daily AI spend). Leave empty to turn off.
# Setup: scripts/telegram-setup.ts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional daily AI spend alert thresholds in USD (default 5,10,25,50,100,200)
AI_SPEND_ALERT_THRESHOLDS_USD=
