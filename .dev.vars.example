# Template of local Workers environment variables (tracked in Git with blank values).
# Local development uses .dev.vars (automatically created and git-ignored).
# Staging/prod secrets are set via: wrangler secret put <NAME> --env <staging|prod>

# Cloudflare AI Gateway (required in staging/prod)
# Found on your Cloudflare dashboard sidebar
CLOUDFLARE_ACCOUNT_ID=
# Name of your AI Gateway in Cloudflare
CLOUDFLARE_AI_GATEWAY_ID=
# Optional unless Authenticated Gateway or BYOK is enabled
CLOUDFLARE_AI_GATEWAY_TOKEN=

# Anthropic Claude API
# Your Anthropic API key (sk-ant-...)
ANTHROPIC_API_KEY=
# Optional local dev fallback ('true') if AI Gateway is not configured yet
ALLOW_DIRECT_ANTHROPIC=

# Configurable Model IDs (optional overrides — defaults live in src/config/ai-models.ts)
LLM_MODEL_DRAFT=
LLM_MODEL_VERIFY=
LLM_MODEL_EXTRACT=
LLM_MODEL_CLASSIFY=

# Internal Smoke Routes & Observability
# Random bearer secret protecting /api/internal/* in staging/prod
INTERNAL_SMOKE_TOKEN=
# Optional Sentry DSN for error tracking
SENTRY_DSN=
