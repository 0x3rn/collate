# Template of local Workers environment variables (tracked in Git with blank values).
# Local development uses .dev.vars (automatically created and git-ignored).
# Production secrets are set via: wrangler secret put <NAME>

# Local runtime override
APP_ENV=
APP_URL=
EXPORT_SIGNING_SECRET=
# Comma-separated operator emails allowed to access /admin
ADMIN_EMAILS=

# Payments (Paystack NGN & Stripe International)
# Paystack secret key (sk_test_... / sk_live_...)
PAYSTACK_SECRET_KEY=
# Stripe secret key (sk_test_... / sk_live_...)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email Delivery
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=

# Web Search & Scholarly Source APIs
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
SCHOLARLY_CONTACT_EMAIL=

# Cloudflare AI Gateway & Anthropic
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_ID=
CLOUDFLARE_AI_GATEWAY_TOKEN=
ANTHROPIC_API_KEY=
ALLOW_DIRECT_ANTHROPIC=
LLM_MODEL_DRAFT=
LLM_MODEL_VERIFY=
LLM_MODEL_EXTRACT=
LLM_MODEL_CLASSIFY=

# Internal Smoke Routes & Observability
INTERNAL_SMOKE_TOKEN=
SENTRY_DSN=
