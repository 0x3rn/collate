{
  "name": "collate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "@vinext/cloudflare": "latest",
    "docx": "^9.16.0",
    "drizzle-orm": "^0.45.4",
    "pdf-lib": "^1.17.1",
    "postal-mime": "2.7.2",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "latest",
    "server-only": "^0.0.1",
    "vinext": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tailwindcss": "latest",
    "tsx": "4.23.15",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "latest",
    "vitest": "^5.1.1",
    "wrangler": "4.165.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=scripts/seed.sql"
  }
}
