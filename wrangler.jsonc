// Collate — Cloudflare Workers configuration (pre-launch: main deploys directly to 'collate')
// D1 (DB), R2 (FILES), Browser Run (BROWSER), Images (IMAGES), Workers AI (AI), and Workflows.
// Local dev overrides APP_ENV=dev via git-ignored .dev.vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collate",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_NAME": "Collate",
    "APP_ENV": "prod",
    "APP_URL": "https://collate.corstack.dev",
    "EMAIL_PROVIDER": "resend",
    "EMAIL_FROM": "Collate <collate@corstack.dev>",
    "ADMIN_EMAILS": "somto.ike.dev@gmail.com",
    "SCHOLARLY_CONTACT_EMAIL": "collate@corstack.dev",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFSFBv33VMh4DpXy",
    "GEMINI_API_BACKEND": "vertex-express",
    "GOOGLE_CLOUD_PROJECT": "545937744162",
    // Each LLM_MODEL_* accepts any mix of Google (gemini-4-neon, gemini-4-hydrogen, gemini-4-argon, gemini-4-carbon, gemini-3.8-flash, gemini-3.7-flash, gemini-3.5-flash-lite),
    // DeepSeek (deepseek-flash, deepseek-v4-pro), OpenAI (gpt-6.1-sol, gpt-6-luna, gpt-5.4), or Anthropic (claude-sonnet-5-5, claude-haiku-5-5).
    // Only the provider(s) referenced below need their API key secret set.
    // Set USE_CLOUDFLARE_AI_GATEWAY to "true" to route LLM calls through Cloudflare AI Gateway (defaults to "false").
    "USE_CLOUDFLARE_AI_GATEWAY": "false",
    "LLM_MODEL_DRAFT": "gemini-4-neon",
    "LLM_MODEL_VERIFY": "gemini-4-hydrogen",
    "LLM_MODEL_EXTRACT": "deepseek-flash",
    "LLM_MODEL_CLASSIFY": "gemini-4-hydrogen",
  },
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*", "!/images/*"],
  },
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "collate-db",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "collate-files",
    },
  ],
  "browser": {
    "binding": "BROWSER",
  },
  "workflows": [
    {
      "name": "collate-hello-sleep",
      "binding": "HELLO_SLEEP_WORKFLOW",
      "class_name": "HelloSleepWorkflow",
    },
    {
      "name": "collate-research-sweep",
      "binding": "RESEARCH_SWEEP_WORKFLOW",
      "class_name": "ResearchSweepWorkflow",
    },
    {
      "name": "collate-write-chapter",
      "binding": "WRITE_CHAPTER_WORKFLOW",
      "class_name": "WriteChapterWorkflow",
    },
  ],
  "ai": {
    "binding": "AI",
  },
}
