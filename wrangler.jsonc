// Collate — Cloudflare Workers configuration (pre-launch: main deploys directly to 'collate')
// D1 (DB), R2 (FILES), Browser Run (BROWSER), Images (IMAGES), Workers AI (AI), and Workflows.
// Local dev overrides APP_ENV=dev via git-ignored .dev.vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collate",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  // Hourly: check Polar for payment disputes (Polar sends no dispute webhooks).
  "triggers": { "crons": ["23 * * * *"] },
  "vars": {
    "APP_NAME": "Collate",
    "APP_ENV": "prod",
    "APP_URL": "https://collateresearch.app",
    "EMAIL_PROVIDER": "cloudflare",
    // Sender for automatic emails (verification codes, receipts, chapter updates). Replies go to support.
    "EMAIL_FROM": "Collate <noreply@collateresearch.app>",
    "EMAIL_REPLY_TO": "support@collateresearch.app",
    // Admin inbox: mail sent to each address lands in its own tab. Route each address to this
    // Worker in Cloudflare Email Routing. Announcements and promotions are sent from their address.
    "EMAIL_SUPPORT_ADDRESS": "support@collateresearch.app",
    "EMAIL_BILLING_ADDRESS": "billing@collateresearch.app",
    "EMAIL_GENERAL_ADDRESS": "hello@collateresearch.app",
    "EMAIL_ANNOUNCEMENTS_ADDRESS": "news@collateresearch.app",
    "EMAIL_PROMOTIONS_ADDRESS": "offers@collateresearch.app",
    // Live Polar products (USD credit packs). Not secret; the access token is a secret.
    "POLAR_PRODUCT_ID_STARTER": "e3239859-df18-4be3-91c5-a7954454041d",
    "POLAR_PRODUCT_ID_PROJECT": "16b4c31f-c132-461d-a820-a4557178b878",
    "POLAR_PRODUCT_ID_THESIS": "48b7fe44-cb62-4831-9c89-abf7abf27a20",
    "ADMIN_EMAILS": "somto.ike.dev@gmail.com",
    "SCHOLARLY_CONTACT_EMAIL": "support@collateresearch.app",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAGTFM7aEpZKIqjNc",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-G788RL6915",
    "GEMINI_API_BACKEND": "vertex-express",
    "GOOGLE_CLOUD_PROJECT": "545937744162",
    // Each LLM_MODEL_* accepts any mix of Google (gemini-4-neon, gemini-4-hydrogen, gemini-4-argon, gemini-4-carbon, gemini-3.8-flash, gemini-3.7-flash, gemini-3.5-flash-lite),
    // DeepSeek (deepseek-flash, deepseek-v4-pro), OpenAI (gpt-6.1-sol, gpt-6-luna, gpt-5.4), or Anthropic (claude-sonnet-5-5, claude-haiku-5-5).
    // Only the provider(s) referenced below need their API key secret set.
    // Set USE_CLOUDFLARE_AI_GATEWAY to "true" to route LLM calls through Cloudflare AI Gateway (defaults to "false").
    "USE_CLOUDFLARE_AI_GATEWAY": "false",
    "LLM_MODEL_DRAFT": "gemini-4-neon",
    "LLM_MODEL_VERIFY": "gemini-4-hydrogen",
    "LLM_MODEL_EXTRACT": "deepseek-flash",
    "LLM_MODEL_CLASSIFY": "gemini-4-hydrogen",
  },
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*",
      "!/images/*",
      "!/brand/*",
      "!/email/*",
      "!/og-image.png",
      "!/llms.txt",
    ],
  },
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "collate-db",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "collate-files",
    },
  ],
  "browser": {
    "binding": "BROWSER",
    // Local dev uses the real Browser Run service (PDFs), like production.
    "remote": true,
  },
  "workflows": [
    {
      "name": "collate-hello-sleep",
      "binding": "HELLO_SLEEP_WORKFLOW",
      "class_name": "HelloSleepWorkflow",
    },
    {
      "name": "collate-research-sweep",
      "binding": "RESEARCH_SWEEP_WORKFLOW",
      "class_name": "ResearchSweepWorkflow",
    },
    {
      "name": "collate-write-chapter",
      "binding": "WRITE_CHAPTER_WORKFLOW",
      "class_name": "WriteChapterWorkflow",
    },
    {
      "name": "collate-broadcast-email",
      "binding": "BROADCAST_EMAIL_WORKFLOW",
      "class_name": "BroadcastEmailWorkflow",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  // Cloudflare Email Sending (outgoing mail). The sending domain is onboarded in the dashboard.
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
    },
  ],
}
