// Collate — Cloudflare Workers configuration
// Default = dev. Use --env staging or --env prod for remote environments.
// Run scripts/bootstrap/provision-cloudflare.mjs after 'wrangler login' to populate real remote IDs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collate-dev",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"],
  },
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_NAME": "Collate",
    "APP_ENV": "dev",
  },
  "env": {
    "staging": {
      "name": "collate-staging",
      "observability": {
        "enabled": true,
      },
      "vars": {
        "APP_NAME": "Collate",
        "APP_ENV": "staging",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "collate-staging",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "drizzle",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "collate-files-staging",
        },
      ],
    },
    "prod": {
      "name": "collate-prod",
      "observability": {
        "enabled": true,
      },
      "vars": {
        "APP_NAME": "Collate",
        "APP_ENV": "prod",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "collate-prod",
          "database_id": "00000000-0000-0000-0000-000000000003",
          "migrations_dir": "drizzle",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "collate-files-prod",
        },
      ],
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "collate-dev",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "collate-files-dev",
    },
  ],
}
